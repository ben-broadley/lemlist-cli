#!/usr/bin/env bash
# Back-compat shim for lem v0.2 (`lemlist <generated-command>`).
#
# v0.3 replatformed this repo: the 120 hand-generated REST commands are gone,
# because lemlist now ships an official CLI that generates the same surface from
# the *live* spec (@lemlist-official/cli). We delegate to it instead of racing it.
#
# Kept so existing callers — notably BAM-AU/ops/shared/bin/lemlist, which execs
# "$CLI_HOME/lemlist" — keep working across the cutover.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
LEM="$HERE/lem"

# Loop breaker. `lem rest` execs the official CLI by the name `lemlist`; if a
# credential-injecting wrapper earlier on PATH (BAM ops ships one) execs this
# shim instead, we would bounce back into lem forever. lem sets LEM_DELEGATING
# on the child, so reaching this file with it set means the official CLI is
# being shadowed.
if [[ -n "${LEM_DELEGATING:-}" ]]; then
    cat >&2 <<'EOF'
lemlist: PATH loop — `lem rest` resolved `lemlist` back to this repo's shim
instead of the official CLI. Something earlier on PATH named `lemlist` is
shadowing @lemlist-official/cli.

Fix either way:
  export LEMLIST_BIN=$(npm root -g)/@lemlist-official/cli/dist/cli.js
  # or rename the shadowing wrapper so it no longer claims the name `lemlist`
EOF
    exit 127
fi

case "${1:-}" in
    dump-all)
        # The one command that moved across unchanged.
        exec "$LEM" "$@"
        ;;
    ""|-h|--help)
        exec "$LEM" --help
        ;;
    -V|--version)
        exec "$LEM" --version
        ;;
    doctor|rest|mcp)
        exec "$LEM" "$@"
        ;;
    commands|help)
        cat >&2 <<'EOF'
lemlist: `commands` / `help` are gone in v0.3.

Discover the surfaces instead:
  lem rest --help          REST (the official CLI, 143 operations)
  lem mcp tools            MCP actions (124 tools)
EOF
        exit 1
        ;;
    *)
        cat >&2 <<EOF
lemlist: '$1' was a v0.2 generated command. Those were retired in v0.3.

  REST  ->  lem rest <group> <action>      e.g. lem rest campaigns list
            lem rest api GET /campaigns    any endpoint, by path
  MCP   ->  lem mcp call <tool>            e.g. lem mcp call get_team_info

  lem doctor    check the toolchain
EOF
        exit 1
        ;;
esac
