VERSION = "0.2.0"
SPEC_PATH = Path(__file__).resolve().parent / "openapi.json"
BASE_URL = "https://api.lemlist.com/api"
API_KEY_ENV = "LEMLIST_API_KEY"
USER_AGENT = f"lemlist-cli/{VERSION}"
ENVELOPE_KEYS = (
    "data", "items", "results",
    "leads", "campaigns", "activities", "contacts", "companies",
    "unsubscribes", "tasks", "schedules", "hooks", "messages",
    "drafts", "labels", "inboxes", "signals",
)


def slugify(s: str) -> str:
    return re.sub(r"[^A-Za-z0-9]+", "-", s).strip("-").lower()


def load_spec() -> dict:
    with SPEC_PATH.open() as f:
        return json.load(f)


METHODS = ("get", "post", "put", "patch", "delete")


# Hand-picked defaults for endpoints whose `requestBody` schema is too open-ended
# for the spec to capture a useful default (e.g. lemleads search needs `filters`,
# `page`, `size` but the spec marks them all optional).
BODY_DEFAULTS: dict = {
    "search-people-database": {"filters": [], "page": 1, "size": 100},
    "search-companies-database": {"filters": [], "page": 1, "size": 100},
}

# Backward-compatible aliases for command names that existed before the full-spec
# expansion. Maps old name -> current auto-derived name.
COMMAND_ALIASES: dict = {
    "search-people": "search-people-database",
    "search-companies": "search-companies-database",
    "batch-campaign-stats": "get-batch-campaign-stats",
}


def _extract_body_schema(op: dict) -> dict | None:
    """Pull the JSON body schema out of an operation's requestBody, if any."""
    rb = op.get("requestBody")
    if not rb:
        return None
    content = (rb.get("content") or {}).get("application/json", {})
    schema = content.get("schema")
    if not schema:
        return None
    return {
        "schema": schema,
        "required_top": list(schema.get("required") or []),
        "properties": dict(schema.get("properties") or {}),
        "request_body_required": bool(rb.get("required")),
    }


def build_registry(spec: dict) -> dict:
    """Map command name -> operation metadata for every operation in the spec.

    OpenAPI parameters can be declared at the path level (shared across all methods
    on that path) or the operation level. Merge both — operation-level wins on collision.
    """
    registry: dict = {}
    for path, methods in spec.get("paths", {}).items():
        path_level = methods.get("parameters", []) or []
        for method in METHODS:
            op = methods.get(method)
            if not op:
                continue
            op_level = op.get("parameters", []) or []
            seen = {p["name"] for p in op_level}
            params = op_level + [p for p in path_level if p["name"] not in seen]
            summary = op.get("summary") or op.get("operationId") or path
            name = slugify(summary)
            base, i = name, 2
            while name in registry:
                name = f"{base}-{i}"
                i += 1
            entry = {
                "path": path,
                "summary": summary,
                "description": op.get("description", "") or "",
                "path_params": [p for p in params if p.get("in") == "path"],
                "query_params": [p for p in params if p.get("in") == "query"],
                "method": method.upper(),
                "body": _extract_body_schema(op),
            }
            if name in BODY_DEFAULTS:
                entry["default_body"] = BODY_DEFAULTS[name]
            registry[name] = entry
    return registry


def _basic_auth_header(api_key: str, user: str) -> str:
    return "Basic " + base64.b64encode(f"{user}:{api_key}".encode()).decode()


def http_request(
    method: str,
    path: str,
    query: dict | None = None,
    body: object = None,
    api_key: str = "",
    user: str = "",
    verbose: bool = False,
    dry_run: bool = False,
) -> object:
    """Single HTTP entry point. GET/DELETE ignore `body`; POST/PUT/PATCH send JSON.

    If `dry_run` is True, returns a stand-in dict describing what would have been
    sent instead of making the network call. The Authorization header is never
    included in dry-run output or verbose logs.
    """
    qs_pairs = [(k, v) for k, v in (query or {}).items() if v is not None and v != ""]
    qs = urllib.parse.urlencode(qs_pairs, doseq=True)
    url = BASE_URL + path + (("?" + qs) if qs else "")
    headers = {
        "Authorization": _basic_auth_header(api_key, user),
        "Accept": "application/json",
        "User-Agent": USER_AGENT,
    }
    data = None
    if method in ("POST", "PUT", "PATCH") and body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"

    if verbose:
        # Print method + URL to stderr. Never log the Authorization header.
        sys.stderr.write(f"→ {method} {url}\n")
        for hk, hv in headers.items():
            if hk == "Authorization":
                continue
            sys.stderr.write(f"  {hk}: {hv}\n")
        if data is not None:
            sys.stderr.write(f"  body: {data.decode()}\n")

    if dry_run:
        return {
            "_dry_run": True,
            "method": method,
            "url": url,
            "headers": {k: v for k, v in headers.items() if k != "Authorization"},
            "body": body if body is not None else None,
        }

    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            text = resp.read().decode() or "null"
            try:
                return json.loads(text)
            except json.JSONDecodeError:
                return text
    except urllib.error.HTTPError as e:
        body_text = e.read().decode(errors="replace")
        raise SystemExit(f"HTTP {e.code} on {method} {url}\n{body_text}")
    except (socket.timeout, TimeoutError) as e:
        raise SystemExit(f"timeout (>120s) on {method} {url}: {e}")
    except urllib.error.URLError as e:
        raise SystemExit(f"network error on {method} {url}: {e}")


# Back-compat shims for the internal helpers.
def request(path: str, query: dict, api_key: str, user: str = "") -> object:
    return http_request("GET", path, query=query, api_key=api_key, user=user)


def request_post(path: str, body: object, api_key: str, user: str = "") -> object:
    return http_request("POST", path, body=body, api_key=api_key, user=user)


def _items_from_envelope(payload):
    if isinstance(payload, list):
        return payload, None
    if isinstance(payload, dict):
        for k in ENVELOPE_KEYS:
            v = payload.get(k)
            if isinstance(v, list):
                return v, k
    return None, None


def auto_paginate(meta: dict, query: dict, api_key: str, user: str, verbose: bool = False) -> object:
    """Walk pagination if the endpoint advertises offset/limit or page."""
    qnames = {p["name"] for p in meta["query_params"]}
    path = meta["path"]

    def _get(q: dict) -> object:
        return http_request("GET", path, query=q, api_key=api_key, user=user, verbose=verbose)

    if "offset" in qnames and "limit" in qnames:
        limit = int(query.get("limit") or 100)
        query["limit"] = limit
        offset = int(query.get("offset") or 0)
        results: list = []
        envelope_key = None
        first_payload = None
        while True:
            query["offset"] = offset
            payload = _get(query)
            if first_payload is None:
                first_payload = payload
            items, key = _items_from_envelope(payload)
            if items is None:
                return payload  # not a list-shaped response
            envelope_key = envelope_key or key
            results.extend(items)
            if len(items) < limit:
                break
            offset += limit
            time.sleep(0.05)
        if envelope_key and isinstance(first_payload, dict):
            merged = {k: v for k, v in first_payload.items() if k != envelope_key}
            merged[envelope_key] = results
            return merged
        return results

    if "page" in qnames:
        page_num = int(query.get("page") or 1)
        limit = int(query.get("limit") or 100)
        query["limit"] = limit
        results = []
        envelope_key = None
        first_payload = None
        while True:
            query["page"] = page_num
            payload = _get(query)
            if first_payload is None:
                first_payload = payload
            items, key = _items_from_envelope(payload)
            if items is None:
                return payload
            envelope_key = envelope_key or key
            if not items:
                break
            results.extend(items)
            if len(items) < limit:
                break
            page_num += 1
            time.sleep(0.05)
        if envelope_key and isinstance(first_payload, dict):
            merged = {k: v for k, v in first_payload.items() if k != envelope_key}
            merged[envelope_key] = results
            return merged
        return results

    return _get(query)


def cmd_commands(registry: dict) -> None:
    width = max(len(n) for n in registry)
    counts: dict = {}
    for name in sorted(registry):
        meta = registry[name]
        method = meta.get("method", "GET")
        counts[method] = counts.get(method, 0) + 1
        print(f"{name:<{width}}  {method:6s} {meta['path']}")
    summary = ", ".join(f"{m}: {n}" for m, n in sorted(counts.items()))
    print(f"\n{len(registry)} commands  ({summary})")
    print("`lemlist help <name>` for details. POST/PUT/PATCH/DELETE mutate your tenant.")


def _is_primitive_schema(s: dict) -> bool:
    t = s.get("type")
    return t in ("string", "integer", "number", "boolean")


def cmd_help(registry: dict, command: str | None) -> None:
    if not command:
        sys.exit("usage: lemlist help <command>")
    command = COMMAND_ALIASES.get(command, command)
    if command not in registry:
        sys.exit(f"unknown command: {command}")
    meta = registry[command]
    method = meta.get("method", "GET")
    print(f"{command}\n  {method} {meta['path']}")
    if meta["summary"]:
        print(f"  {meta['summary']}")
    if meta["description"]:
        print(f"\n{meta['description'].strip()}\n")
    if meta["path_params"]:
        print("Positional arguments:")
        for p in meta["path_params"]:
            print(f"  {p['name']:20s} {p.get('description', '').strip()}")
    if meta["query_params"]:
        print("\nQuery flags:")
        for p in meta["query_params"]:
            req = " (required)" if p.get("required") else ""
            enum = p.get("schema", {}).get("enum")
            extra = f" [one of: {', '.join(enum)}]" if enum else ""
            print(f"  --{p['name']}{req}{extra}")
            desc = (p.get("description") or "").strip().splitlines()
            for line in desc[:3]:
                print(f"      {line}")
    body = meta.get("body")
    if body or method in ("POST", "PUT", "PATCH"):
        print("\nBody flags:")
        print("  --body JSON     JSON string for the request body")
        print("  --body-file F   path to a JSON body file (use - for stdin)")
        if body and body.get("properties"):
            req_set = set(body.get("required_top") or [])
            print("\n  Top-level fields from the spec:")
            for fname, fschema in body["properties"].items():
                ftype = fschema.get("type") or ("ref" if "$ref" in fschema else "?")
                req_mark = " (required)" if fname in req_set else ""
                desc = (fschema.get("description") or "").strip().splitlines()
                first = desc[0] if desc else ""
                if _is_primitive_schema(fschema):
                    print(f"    --{fname}{req_mark}  [{ftype}] {first}")
                else:
                    enum = fschema.get("enum")
                    if enum:
                        print(f"    --{fname}{req_mark}  [enum: {', '.join(map(str, enum))}] {first}")
                    else:
                        print(f"    {fname}{req_mark}  [{ftype}, complex — use --body] {first}")
        if meta.get("default_body") is not None:
            print(f"\n  default body:  {json.dumps(meta['default_body'])}")
    print("\nGlobal flags:")
    print("  --all           auto-paginate (offset/limit or page) — GET only")
    print("  --out PATH      write JSON to file instead of stdout")
    print("  --user NAME     basic-auth username (default: empty)")
    print("  --verbose       print the HTTP request line to stderr before sending")
    if method in ("POST", "PUT", "PATCH", "DELETE"):
        print("  --dry-run       show what would be sent without sending it")


def _autofill_required(meta: dict, query: dict) -> tuple[dict, str | None]:
    """Fill in obvious defaults for required query params (e.g. version=v2).
    Returns (query, missing_param_name_or_None)."""
    out = dict(query)
    for p in meta["query_params"]:
        if not p.get("required"):
            continue
        if p["name"] in out:
            continue
        schema = p.get("schema", {}) or {}
        if p["name"] == "version":
            out["version"] = "v2"
        elif "default" in schema:
            out[p["name"]] = schema["default"]
        elif schema.get("enum"):
            out[p["name"]] = schema["enum"][0]
        else:
            return out, p["name"]
    return out, None


def _coerce_primitive(value: str, schema: dict):
    """Coerce a CLI string into the JSON type the schema expects."""
    t = schema.get("type")
    if t == "integer":
        return int(value)
    if t == "number":
        return float(value)
    if t == "boolean":
        return value.lower() in ("true", "1", "yes", "y")
    return value


def run_endpoint(registry: dict, name: str, argv: list[str]) -> None:
    meta = registry[name]
    method = meta.get("method", "GET")
    has_body_method = method in ("POST", "PUT", "PATCH")
    body_schema = meta.get("body") or {}
    body_props = body_schema.get("properties") or {}
    primitive_body_flags = {
        fname: fschema for fname, fschema in body_props.items()
        if _is_primitive_schema(fschema)
    }
    query_names = {p["name"] for p in meta["query_params"]}
    # Avoid collision: if a body field has the same name as a query param, the
    # query param wins (it's directly addressable; body always reachable via --body).
    primitive_body_flags = {
        k: v for k, v in primitive_body_flags.items() if k not in query_names
    }

    parser = argparse.ArgumentParser(
        prog=f"lemlist {name}",
        description=meta["summary"],
    )
    for p in meta["path_params"]:
        parser.add_argument(p["name"], help=(p.get("description") or "").strip())
    for p in meta["query_params"]:
        parser.add_argument(
            f"--{p['name']}",
            required=False,  # required check happens after autofill
            help=(p.get("description") or "").strip(),
        )
    if has_body_method:
        parser.add_argument("--body", help="JSON string for the request body")
        parser.add_argument(
            "--body-file",
            help="Path to JSON body file (use - for stdin)",
        )
        for fname, fschema in primitive_body_flags.items():
            parser.add_argument(
                f"--{fname}",
                required=False,
                help=(fschema.get("description") or "").strip(),
            )
    parser.add_argument("--all", action="store_true", help="Auto-paginate all pages (GET only)")
    parser.add_argument("--out", help="Write JSON to file instead of stdout")
    parser.add_argument("--user", default="", help="Basic auth username (default empty)")
    parser.add_argument("--verbose", action="store_true",
                        help="Print the HTTP method, URL, and non-auth headers to stderr before sending")
    if has_body_method or method == "DELETE":
        parser.add_argument("--dry-run", action="store_true",
                            help="Print the request that would be sent (method, URL, body) without sending it")
    args = parser.parse_args(argv)
    dry_run = bool(getattr(args, "dry_run", False))

    api_key = os.environ.get(API_KEY_ENV) or ""
    if not api_key and not dry_run:
        sys.exit(f"set {API_KEY_ENV} in your environment")

    path = meta["path"]
    for p in meta["path_params"]:
        val = getattr(args, p["name"])
        path = path.replace("{" + p["name"] + "}", urllib.parse.quote(str(val), safe=""))

    query: dict = {}
    for p in meta["query_params"]:
        v = getattr(args, p["name"])
        if v is not None:
            query[p["name"]] = v

    if has_body_method:
        body: object | None
        if args.body_file == "-":
            body = json.load(sys.stdin)
        elif args.body_file:
            body = json.loads(Path(args.body_file).read_text())
        elif args.body:
            body = json.loads(args.body)
        else:
            body = None
        # Merge primitive flags into the body (flags take precedence over --body keys).
        per_field: dict = {}
        for fname, fschema in primitive_body_flags.items():
            v = getattr(args, fname.replace("-", "_"), None)
            if v is not None:
                per_field[fname] = _coerce_primitive(v, fschema)
        if per_field:
            if body is None:
                body = {}
            if not isinstance(body, dict):
                sys.exit("cannot merge --<field> flags into non-dict --body")
            body = {**body, **per_field}
        if body is None and meta.get("default_body") is not None:
            body = meta["default_body"]
        result = http_request(method, path, query=query, body=body, api_key=api_key,
                              user=args.user, verbose=args.verbose, dry_run=dry_run)
    elif method == "DELETE":
        result = http_request("DELETE", path, query=query, api_key=api_key,
                              user=args.user, verbose=args.verbose, dry_run=dry_run)
    else:  # GET
        query, missing = _autofill_required(meta, query)
        if missing:
            sys.exit(f"missing required flag: --{missing}")
        meta_resolved = dict(meta, path=path)
        if args.all:
            result = auto_paginate(meta_resolved, query, api_key, args.user, verbose=args.verbose)
        else:
            result = http_request("GET", path, query=query, api_key=api_key,
                                  user=args.user, verbose=args.verbose)

    out_text = json.dumps(result, indent=2, ensure_ascii=False)
    if args.out:
        Path(args.out).write_text(out_text)
        sys.stderr.write(f"wrote {len(out_text):,} bytes to {args.out}\n")
    else:
        print(out_text)


