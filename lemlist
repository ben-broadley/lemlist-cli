#!/usr/bin/env python3
"""lemlist — read-only CLI over the lemlist REST API.

Auto-generated from the OpenAPI spec sitting next to this script (openapi.json).
Set LEMLIST_API_KEY in your environment. JSON is written to stdout.

Quick start:
  export LEMLIST_API_KEY=...
  ./lemlist commands                   # list every available command
  ./lemlist help get-many-campaigns    # show args/flags for one command
  ./lemlist get-team
  ./lemlist get-many-campaigns --status running --all
  ./lemlist get-campaign cam_xxx
  ./lemlist dump-all ../lemlist-data   # pull every list endpoint into a folder
  ./lemlist dump-all ../lemlist-data --with-campaigns  # also drill per-campaign

Auth: lemlist uses HTTP Basic with the API key as the password and an
empty username. Override with --user if needed.
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import re
import socket
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

SPEC_PATH = Path(__file__).resolve().parent / "openapi.json"
BASE_URL = "https://api.lemlist.com/api"
API_KEY_ENV = "LEMLIST_API_KEY"
USER_AGENT = "lemlist-cli/0.1"
ENVELOPE_KEYS = (
    "data", "items", "results",
    "leads", "campaigns", "activities", "contacts", "companies",
    "unsubscribes", "tasks", "schedules", "hooks", "messages",
    "drafts", "labels", "inboxes", "signals",
)


def slugify(s: str) -> str:
    return re.sub(r"[^A-Za-z0-9]+", "-", s).strip("-").lower()


def load_spec() -> dict:
    with SPEC_PATH.open() as f:
        return json.load(f)


def build_registry(spec: dict) -> dict:
    """Map command name -> operation metadata for every GET endpoint.

    OpenAPI parameters can be declared at the path level (shared across all methods
    on that path) or the operation level. Merge both — operation-level wins on collision.
    """
    registry: dict = {}
    for path, methods in spec.get("paths", {}).items():
        path_level = methods.get("parameters", []) or []
        op = methods.get("get")
        if not op:
            continue
        op_level = op.get("parameters", []) or []
        seen = {p["name"] for p in op_level}
        params = op_level + [p for p in path_level if p["name"] not in seen]
        summary = op.get("summary") or op.get("operationId") or path
        name = slugify(summary)
        base, i = name, 2
        while name in registry:
            name = f"{base}-{i}"
            i += 1
        registry[name] = {
            "path": path,
            "summary": summary,
            "description": op.get("description", "") or "",
            "path_params": [p for p in params if p.get("in") == "path"],
            "query_params": [p for p in params if p.get("in") == "query"],
            "method": "GET",
        }
    # Add hand-curated POST endpoints that are reads but documented outside the spec.
    for name, meta in POST_COMMANDS.items():
        registry[name] = dict(meta, path_params=[], query_params=[], method="POST")
    return registry


