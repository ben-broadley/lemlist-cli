# --------------------------------------------------------------------------
# shared helpers
# --------------------------------------------------------------------------

def die(msg: str, code: int = 1):
    sys.stderr.write(msg.rstrip() + "\n")
    raise SystemExit(code)


def api_key() -> str:
    k = os.environ.get(API_KEY_ENV)
    if not k:
        die(f"set {API_KEY_ENV} in your environment (or run: lem doctor)")
    return k


def _cache_path(name: str) -> Path:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    return CACHE_DIR / name


def cached_json(name: str, ttl_s: int, fetch, refresh: bool = False):
    """Read `name` from cache if fresh, else fetch and rewrite it.

    On a fetch failure we fall back to whatever stale copy exists — a snapshot
    against a slightly old spec beats no snapshot at all.
    """
    path = _cache_path(name)
    if not refresh and path.exists():
        try:
            blob = json.loads(path.read_text())
            if time.time() - blob.get("fetchedAt", 0) < ttl_s:
                return blob["doc"]
        except (json.JSONDecodeError, KeyError, OSError):
            pass
    try:
        doc = fetch()
    except SystemExit:
        if path.exists():
            try:
                sys.stderr.write(f"warning: could not refresh {name}, using cached copy\n")
                return json.loads(path.read_text())["doc"]
            except (json.JSONDecodeError, KeyError, OSError):
                pass
        raise
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps({"fetchedAt": time.time(), "doc": doc}))
    os.replace(tmp, path)
    return doc


def _http(method: str, url: str, headers: dict, data: bytes | None = None, timeout: int = 120):
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            text = resp.read().decode() or "null"
            try:
                return json.loads(text)
            except json.JSONDecodeError:
                return text
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        die(f"HTTP {e.code} on {method} {url}\n{body}")
    except (socket.timeout, TimeoutError) as e:
        die(f"timeout (>{timeout}s) on {method} {url}: {e}")
    except urllib.error.URLError as e:
        die(f"network error on {method} {url}: {e}")


def out_json(payload, compact: bool = False):
    if isinstance(payload, str):
        print(payload)
        return
    print(json.dumps(payload, ensure_ascii=False) if compact
          else json.dumps(payload, indent=2, ensure_ascii=False))


# --------------------------------------------------------------------------
# surface 1: rest — delegate to the official CLI
# --------------------------------------------------------------------------

INSTALL_HINT = (
    f"official lemlist CLI not found on PATH as `{OFFICIAL_BIN}`.\n"
    "  install it:  npm install -g @lemlist-official/cli\n"
    "  or point at it:  export LEMLIST_BIN=/path/to/lemlist"
)


def official_bin() -> str:
    """Resolve the *official* CLI, not something else named `lemlist`.

    `lemlist` is a crowded name: this repo ships a back-compat shim by that
    name, and wrappers that inject credentials (BAM ops has one) commonly sit
    earlier on PATH and exec ours. A naive which() therefore resolves back into
    us and recurses forever. So: honour LEMLIST_BIN, then prefer a candidate
    that actually resolves into the @lemlist-official package, and never accept
    our own shim. LEM_DELEGATING is the backstop the shim checks.
    """
    explicit = os.environ.get("LEMLIST_BIN")
    if explicit:
        if not (os.path.isfile(explicit) and os.access(explicit, os.X_OK)):
            die(f"LEMLIST_BIN is not an executable file: {explicit}", 127)
        return explicit

    self_shim = (Path(__file__).resolve().parent / "lemlist").resolve()
    candidates = []
    for d in os.environ.get("PATH", "").split(os.pathsep):
        if not d:
            continue
        cand = Path(d) / OFFICIAL_BIN
        if not (cand.is_file() and os.access(cand, os.X_OK)):
            continue
        try:
            real = cand.resolve()
        except OSError:
            continue
        if real == self_shim:
            continue
        candidates.append((cand, real))

    for cand, real in candidates:
        if "@lemlist-official" in str(real):
            return str(cand)
    if candidates:
        return str(candidates[0][0])
    die(INSTALL_HINT, 127)


def cmd_rest(argv: list[str]) -> int:
    """Pass argv straight through to the official CLI.

    We inject --key from LEMLIST_API_KEY only when the caller has not already
    chosen a credential (--key / --account) and has not asked for the auth
    subcommand, so `lem rest auth login` still does the OAuth dance and named
    profiles keep working untouched.
    """
    binpath = official_bin()
    args = list(argv)
    chooses_cred = any(a in ("--key", "--account") for a in args)
    is_auth = bool(args) and args[0] == "auth"
    key = os.environ.get(API_KEY_ENV)
    if key and not chooses_cred and not is_auth:
        args = ["--key", key] + args
    env = dict(os.environ, LEM_DELEGATING="1")
    return subprocess.call([binpath] + args, env=env)


# --------------------------------------------------------------------------
# surface 2: mcp — JSON-RPC against lemlist's MCP endpoint
# --------------------------------------------------------------------------

# Tools that spend money, touch DNS/mailbox infrastructure, send outbound
# messages, or destroy data. --yes is not enough for these; they also need
# --force-danger. Everything matched here is judged on the tool's own contract,
# not on the annotation, because the annotation only says "not read-only".
DANGER_TOOLS = {
    "purchase_domain",            # charges the team via Stripe
    "configure_domain_dns",       # rewrites live DNS
    "provision_mailboxes",        # creates billable mailboxes
    "connect_email_account",
    "disconnect_email_account",   # stops sending immediately, irreversible
    "send_message",               # sends outbound to a real contact
    "send_task",
    "launch_campaign",            # starts real outreach
    "set_campaign_state",
    "run_inbox_placement_test",   # sends ~25 seed emails
    "delete_campaign_leads",
    "import_leads_to_campaign",
    "import_contacts_from_csv",
    "import_companies_from_csv",
    "add_leads_to_campaign",
    "generate_campaign_for_watch_list",
}


def mcp_rpc(method: str, params: dict | None = None, timeout: int = 120):
    body = json.dumps({
        "jsonrpc": "2.0", "id": 1, "method": method, "params": params or {},
    }).encode()
    payload = _http(
        "POST", MCP_URL,
        headers={
            "X-API-Key": api_key(),
            "Content-Type": "application/json",
            # The endpoint negotiates plain JSON but advertises SSE; send both.
            "Accept": "application/json, text/event-stream",
            "User-Agent": USER_AGENT,
        },
        data=body, timeout=timeout,
    )
    if isinstance(payload, dict) and payload.get("error"):
        err = payload["error"]
        die(f"MCP error {err.get('code')}: {err.get('message')}", 6)
    return (payload or {}).get("result") if isinstance(payload, dict) else payload


def mcp_tools(refresh: bool = False) -> list:
    doc = cached_json("mcp-tools.json", MCP_TOOLS_TTL_S,
                      lambda: mcp_rpc("tools/list"), refresh=refresh)
    return doc.get("tools", []) if isinstance(doc, dict) else []


def _is_read_only(tool: dict) -> bool:
    return bool((tool.get("annotations") or {}).get("readOnlyHint"))


def _find_tool(tools: list, name: str) -> dict:
    for t in tools:
        if t["name"] == name:
            return t
    import difflib
    near = difflib.get_close_matches(name, [t["name"] for t in tools], n=3, cutoff=0.5)
    msg = f"unknown MCP tool: {name}"
    if near:
        msg += "\n\nDid you mean:\n" + "\n".join(f"  {n}" for n in near)
    msg += "\n\nRun: lem mcp tools"
    die(msg, 5)


def _coerce(value: str):
    """Best-effort JSON coercion for --set k=v, falling back to the raw string."""
    try:
        return json.loads(value)
    except json.JSONDecodeError:
        return value


def _unwrap(result):
    """MCP returns content[].text holding a JSON string. Unwrap to real JSON."""
    if not isinstance(result, dict):
        return result
    content = result.get("content")
    if not isinstance(content, list):
        return result
    texts = [c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text"]
    if not texts:
        return result
    joined = "\n".join(texts)
    try:
        return json.loads(joined)
    except json.JSONDecodeError:
        return joined


def cmd_mcp(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="lem mcp", add_help=True)
    sub = p.add_subparsers(dest="action", required=True)

    pl = sub.add_parser("tools", help="list the MCP tool surface")
    pl.add_argument("--reads", action="store_true", help="only read-only tools")
    pl.add_argument("--writes", action="store_true", help="only mutating tools")
    pl.add_argument("--search", default="", help="substring filter on name/description")
    pl.add_argument("--json", action="store_true", help="machine-readable output")
    pl.add_argument("--refresh", action="store_true", help="bypass the 24h tool cache")

    ph = sub.add_parser("help", help="show one tool's schema")
    ph.add_argument("tool")
    ph.add_argument("--json", action="store_true")

    pc = sub.add_parser("call", help="invoke one tool")
    pc.add_argument("tool")
    pc.add_argument("--set", action="append", default=[], metavar="K=V",
                    help="argument; value is parsed as JSON when possible (repeatable)")
    pc.add_argument("--data", default="", help="full argument object as a JSON string")
    pc.add_argument("--yes", action="store_true", help="required for any mutating tool")
    pc.add_argument("--force-danger", action="store_true",
                    help="additionally required for billing/irreversible tools")
    pc.add_argument("--dry-run", action="store_true", help="print the request, send nothing")
    pc.add_argument("--raw", action="store_true", help="do not unwrap content[].text")
    pc.add_argument("--json", action="store_true", help="compact output")

    ns = p.parse_args(argv)

    if ns.action == "tools":
        tools = mcp_tools(refresh=ns.refresh)
        if ns.reads:
            tools = [t for t in tools if _is_read_only(t)]
        if ns.writes:
            tools = [t for t in tools if not _is_read_only(t)]
        if ns.search:
            q = ns.search.lower()
            tools = [t for t in tools
                     if q in t["name"].lower() or q in t.get("description", "").lower()]
        if ns.json:
            out_json([{"name": t["name"], "readOnly": _is_read_only(t),
                       "danger": t["name"] in DANGER_TOOLS or t["name"].startswith("delete_"),
                       "description": t.get("description", "").split("\n")[0]}
                      for t in tools])
            return 0
        width = max((len(t["name"]) for t in tools), default=10)
        for t in sorted(tools, key=lambda x: x["name"]):
            if t["name"] in DANGER_TOOLS or t["name"].startswith("delete_"):
                tag = "DANGER"
            elif _is_read_only(t):
                tag = "read  "
            else:
                tag = "write "
            first = t.get("description", "").strip().split("\n")[0][:90]
            print(f"[{tag}] {t['name']:<{width}}  {first}")
        n_read = sum(1 for t in tools if _is_read_only(t))
        print(f"\n{len(tools)} tools ({n_read} read-only, {len(tools) - n_read} mutating)")
        return 0

    tools = mcp_tools()

    if ns.action == "help":
        t = _find_tool(tools, ns.tool)
        if ns.json:
            out_json(t)
            return 0
        danger = t["name"] in DANGER_TOOLS or t["name"].startswith("delete_")
        print(f"{t['name']}  [{'read-only' if _is_read_only(t) else 'MUTATING'}"
              f"{', DANGER — needs --force-danger' if danger else ''}]\n")
        print(t.get("description", "").strip())
        schema = t.get("inputSchema") or {}
        props = schema.get("properties") or {}
        required = set(schema.get("required") or [])
        if props:
            print("\nArguments:")
            for k, v in props.items():
                req = " (required)" if k in required else ""
                typ = v.get("type", "any")
                desc = (v.get("description") or "").split("\n")[0][:100]
                print(f"  --set {k}=<{typ}>{req}\n      {desc}" if desc
                      else f"  --set {k}=<{typ}>{req}")
        print(f"\nExample:\n  lem mcp call {t['name']}"
              + ("" if _is_read_only(t) else " --yes")
              + (" --force-danger" if danger else ""))
        return 0

    # ns.action == "call"
    t = _find_tool(tools, ns.tool)
    args: dict = {}
    if ns.data:
        try:
            parsed = json.loads(ns.data)
        except json.JSONDecodeError as e:
            die(f"--data is not valid JSON: {e}")
        if not isinstance(parsed, dict):
            die("--data must be a JSON object")
        args.update(parsed)
    for pair in ns.set:
        if "=" not in pair:
            die(f"--set expects K=V, got: {pair}")
        k, v = pair.split("=", 1)
        args[k] = _coerce(v)

    read_only = _is_read_only(t)
    danger = t["name"] in DANGER_TOOLS or t["name"].startswith("delete_")
    if not read_only and not ns.yes:
        die(f"{t['name']} mutates your tenant. Re-run with --yes.\n"
            f"  inspect it first:  lem mcp help {t['name']}", 1)
    if danger and not ns.force_danger:
        die(f"{t['name']} is billing-affecting or irreversible.\n"
            f"  it needs BOTH --yes and --force-danger.\n"
            f"  inspect it first:  lem mcp help {t['name']}", 1)

    missing = [k for k in (t.get("inputSchema") or {}).get("required", []) if k not in args]
    if missing:
        die(f"{t['name']} requires: {', '.join(missing)}\n"
            f"  see:  lem mcp help {t['name']}", 1)

    if ns.dry_run:
        out_json({"_dry_run": True, "url": MCP_URL, "method": "tools/call",
                  "tool": t["name"], "readOnly": read_only, "danger": danger,
                  "arguments": args}, compact=ns.json)
        return 0

    result = mcp_rpc("tools/call", {"name": t["name"], "arguments": args})
    out_json(result if ns.raw else _unwrap(result), compact=ns.json)
    return 0


