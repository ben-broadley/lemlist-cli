SPEC_URL = "https://developer.lemlist.com/api-reference/openapi/v2.json"

API_KEY_ENV = "LEMLIST_API_KEY"
USER_AGENT = f"lem/{VERSION}"
CACHE_DIR = Path(os.environ.get("LEM_CACHE_DIR") or (Path.home() / ".lem"))
