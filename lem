def cmd_doctor() -> int:
    ok = True

    def line(label, status, detail=""):
        mark = "ok  " if status else "FAIL"
        print(f"[{mark}] {label}" + (f"  — {detail}" if detail else ""))

    print(f"lem {VERSION}\n")

    line("python", True, f"{sys.version_info.major}.{sys.version_info.minor}")

    found = shutil.which(OFFICIAL_BIN)
    if found:
        try:
            v = subprocess.run([found, "--version"], capture_output=True, text=True,
                               timeout=30).stdout.strip()
        except (subprocess.SubprocessError, OSError):
            v = "unknown version"
        line("official lemlist CLI", True, f"{found} ({v})")
    else:
        ok = False
        line("official lemlist CLI", False, "not on PATH — npm i -g @lemlist-official/cli")

    has_key = bool(os.environ.get(API_KEY_ENV))
    line(f"{API_KEY_ENV}", has_key, "set" if has_key else "not set")
    ok = ok and has_key

    try:
        spec = fetch_spec()
        n_paths = len(spec.get("paths", {}))
        n_ops = sum(1 for p in spec["paths"].values() for m in p if m in METHODS)
        line("live OpenAPI spec", True, f"{n_paths} paths / {n_ops} operations")
    except SystemExit:
        ok = False
        line("live OpenAPI spec", False, SPEC_URL)

    if has_key:
        try:
            tools = mcp_tools()
            n_read = sum(1 for t in tools if _is_read_only(t))
            line("MCP endpoint", True,
                 f"{len(tools)} tools ({n_read} read-only, {len(tools) - n_read} mutating)")
        except SystemExit:
            ok = False
            line("MCP endpoint", False, MCP_URL)
    else:
        line("MCP endpoint", False, f"skipped — needs {API_KEY_ENV}")

    print(f"\ncache: {CACHE_DIR}")
    return 0 if ok else 1


# --------------------------------------------------------------------------
# entry point
# --------------------------------------------------------------------------

USAGE = """lem — one CLI over lemlist

  lem rest <args...>        the official lemlist CLI (REST, 143 operations)
  lem mcp tools             list the MCP action surface
  lem mcp help <tool>       one tool's schema and safety class
  lem mcp call <tool> ...   invoke an MCP tool
  lem dump-all <dir>        resumable, read-only tenant snapshot
  lem doctor                check the toolchain end to end
  lem --version

Run `lem rest --help` for the REST surface, `lem mcp --help` for the MCP one.
"""


def main() -> None:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        print(USAGE)
        return
    if argv[0] in ("-V", "--version"):
        print(f"lem {VERSION}")
        return

    cmd, rest = argv[0], argv[1:]

    if cmd == "rest":
        raise SystemExit(cmd_rest(rest))
    if cmd == "mcp":
        raise SystemExit(cmd_mcp(rest))
    if cmd == "doctor":
        raise SystemExit(cmd_doctor())
    if cmd == "dump-all":
        p = argparse.ArgumentParser(prog="lem dump-all")
        p.add_argument("dir", help="output directory")
        p.add_argument("--with-campaigns", action="store_true", help="Phase 2: per-campaign endpoints")
        p.add_argument("--with-users", action="store_true", help="Phase 3: per-user profile, inbox, lemwarm")
        p.add_argument("--with-lists", action="store_true", help="Phase 4: contact-list contents")
        p.add_argument("--with-companies", action="store_true", help="Phase 5: per-company notes")
        p.add_argument("--with-schedules", action="store_true", help="Phase 6: full schedule details")
        p.add_argument("--with-search", action="store_true", help="Phase 7: read-only POST searches + batch stats")
        p.add_argument("--deep", action="store_true", help="enable every phase above")
        p.add_argument("--include", default="", help="comma-separated commands to pull despite being excluded")
        p.add_argument("--force", action="store_true", help="re-fetch even when the output file exists")
        p.add_argument("--refresh-spec", action="store_true", help="bypass the 1h OpenAPI cache")
        ns = p.parse_args(rest)
        registry = build_registry(fetch_spec(refresh=ns.refresh_spec))
        opts = {
            "with_campaigns": ns.with_campaigns or ns.deep,
            "with_users":     ns.with_users     or ns.deep,
            "with_lists":     ns.with_lists     or ns.deep,
            "with_companies": ns.with_companies or ns.deep,
            "with_schedules": ns.with_schedules or ns.deep,
            "with_search":    ns.with_search    or ns.deep,
            "include":        [s.strip() for s in ns.include.split(",") if s.strip()],
            "force":          ns.force,
        }
        raise SystemExit(cmd_dump_all(registry, ns.dir, opts))

    die(f"unknown command: {cmd}\n\n{USAGE}", 1)


if __name__ == "__main__":
    main()
