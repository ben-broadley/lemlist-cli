def slugify(s: str) -> str:
    import re
    return re.sub(r"[^A-Za-z0-9]+", "-", s).strip("-").lower()


def fetch_spec(refresh: bool = False) -> dict:
    def _get():
        return _http("GET", SPEC_URL,
                     headers={"Accept": "application/json", "User-Agent": USER_AGENT},
                     timeout=60)
    return cached_json("openapi.json", SPEC_TTL_S, _get, refresh=refresh)


def build_registry(spec: dict) -> dict:
    """command name -> operation metadata, for every operation in the spec."""
    registry: dict = {}
    for path, methods in spec.get("paths", {}).items():
        path_level = methods.get("parameters", []) or []
        for method in METHODS:
            op = methods.get(method)
            if not op:
                continue
            op_level = op.get("parameters", []) or []
            seen = {p["name"] for p in op_level}
            params = op_level + [p for p in path_level if p["name"] not in seen]
            name = slugify(op.get("summary") or op.get("operationId") or path)
            base, i = name, 2
            while name in registry:
                name = f"{base}-{i}"
                i += 1
            registry[name] = {
                "path": path,
                "method": method.upper(),
                "key": (method.upper(), path),
                "summary": op.get("summary") or path,
                "path_params": [p for p in params if p.get("in") == "path"],
                "query_params": [p for p in params if p.get("in") == "query"],
            }
    return registry


def by_key(registry: dict, key: tuple) -> tuple[str, dict] | tuple[None, None]:
    for name, meta in registry.items():
        if meta["key"] == key:
            return name, meta
    return None, None


def rest_request(method: str, path: str, query: dict | None = None,
                 body: object = None, verbose: bool = False):
    qs_pairs = [(k, v) for k, v in (query or {}).items() if v is not None and v != ""]
    qs = urllib.parse.urlencode(qs_pairs, doseq=True)
    url = API_BASE_URL + path + (("?" + qs) if qs else "")
    headers = {
        "Authorization": "Basic " + base64.b64encode(f":{api_key()}".encode()).decode(),
        "Accept": "application/json",
        "User-Agent": USER_AGENT,
    }
    data = None
    if method in ("POST", "PUT", "PATCH") and body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    if verbose:
        sys.stderr.write(f"→ {method} {url}\n")  # never log Authorization
    return _http(method, url, headers, data)


def _items_from_envelope(payload):
    """Find the collection inside a list response, or (None, None) for a record.

    A single record can carry a field that happens to be named like an envelope
    — GET /team returns a team object with its own `labels: []` — and treating
    that as the collection both miscounts the result and, on a paginated
    endpoint, would page over the wrong array. A record has a top-level
    identity; a wrapper does not. Use that to tell them apart.
    """
    if isinstance(payload, list):
        return payload, None
    if isinstance(payload, dict):
        if payload.get("_id") or payload.get("id"):
            return None, None
        for k in ENVELOPE_KEYS:
            v = payload.get(k)
            if isinstance(v, list):
                return v, k
    return None, None


def auto_paginate(meta: dict, query: dict, verbose: bool = False):
    """Walk pagination when the endpoint advertises offset/limit or page."""
    qnames = {p["name"] for p in meta["query_params"]}
    path = meta["path"]
    use_offset = "offset" in qnames and "limit" in qnames
    use_page = (not use_offset) and "page" in qnames
    if not (use_offset or use_page):
        return rest_request("GET", path, query, verbose=verbose)

    limit = int(query.get("limit") or 100)
    query["limit"] = limit
    cursor = int(query.get("offset") or 0) if use_offset else int(query.get("page") or 1)
    results: list = []
    envelope_key = None
    first_payload = None
    while True:
        query["offset" if use_offset else "page"] = cursor
        payload = rest_request("GET", path, query, verbose=verbose)
        if first_payload is None:
            first_payload = payload
        items, key = _items_from_envelope(payload)
        if items is None:
            return payload  # not list-shaped
        envelope_key = envelope_key or key
        if not items:
            break
        results.extend(items)
        if len(items) < limit:
            break
        cursor += limit if use_offset else 1
        time.sleep(0.05)
    if envelope_key and isinstance(first_payload, dict):
        merged = {k: v for k, v in first_payload.items() if k != envelope_key}
        merged[envelope_key] = results
        return merged
    return results


def _autofill_required(meta: dict, query: dict) -> tuple[dict, str | None]:
    out = dict(query)
    for p in meta["query_params"]:
        if not p.get("required") or p["name"] in out:
            continue
        schema = p.get("schema", {}) or {}
        if p["name"] == "version":
            out["version"] = "v2"
        elif "default" in schema:
            out[p["name"]] = schema["default"]
        elif schema.get("enum"):
            out[p["name"]] = schema["enum"][0]
        else:
            return out, p["name"]
    return out, None


def _id_of(obj):
    return obj.get("_id") or obj.get("id") if isinstance(obj, dict) else None


def _count(payload):
    if isinstance(payload, list):
        return len(payload)
    items, _ = _items_from_envelope(payload)
    if items is not None:
        return len(items)
    return 1 if payload else 0


def _write(path: Path, payload) -> None:
    """Atomic write — staged through a sibling .tmp and renamed.

    Survives Ctrl+C mid-write: the destination is either complete JSON or absent,
    which is what makes --force-less re-runs safely resumable.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(payload, indent=2, ensure_ascii=False))
    os.replace(tmp, path)


def _read_collection(path: Path) -> list:
    if not path.exists():
        return []
    payload = json.loads(path.read_text())
    if isinstance(payload, list):
        return payload
    items, _ = _items_from_envelope(payload)
    return items or []


def _skip_if_exists(path: Path, label: str, force: bool, results: dict) -> bool:
    if not force and path.exists() and path.stat().st_size > 0:
        sys.stderr.write(f"→ {label} ... cached\n")
        results.setdefault("cached", []).append(label)
        return True
    return False


def _try(fn, label: str, results: dict):
    sys.stderr.write(f"→ {label} ... ")
    sys.stderr.flush()
    try:
        out = fn()
        sys.stderr.write(f"ok ({_count(out)})\n")
        results.setdefault("pulled", []).append(label)
        return out
    except SystemExit as e:
        sys.stderr.write("FAIL\n")
        for line in str(e).splitlines()[:3]:
            sys.stderr.write(f"    {line}\n")
        results.setdefault("failed", []).append((label, str(e)))
        return None


def cmd_dump_all(registry: dict, dir_path: str, opts: dict) -> int:
    api_key()  # fail fast before creating directories
    out_dir = Path(dir_path)
    lists_dir = out_dir / "lists"
    lists_dir.mkdir(parents=True, exist_ok=True)

    results: dict = {"pulled": [], "failed": [], "cached": []}
    skipped_path, skipped_required, skipped_lookup, skipped_write, skipped_excluded = [], [], [], [], []
    include = set(opts.get("include") or [])
    force = bool(opts.get("force"))

    sys.stderr.write("=== Phase 1: list endpoints ===\n")
    for name in sorted(registry):
        meta = registry[name]
        key = meta["key"]
        if meta["method"] != "GET":
            skipped_write.append(name)
            continue
        if meta["path_params"]:
            skipped_path.append(name)
            continue
        if key in LOOKUP_ONLY_PATHS:
            skipped_lookup.append(name)
            continue
        if key in DUMP_EXCLUDED_PATHS and name not in include and meta["path"] not in include:
            skipped_excluded.append(name)
            continue
        query, missing = _autofill_required(meta, {})
        if missing:
            skipped_required.append((name, missing))
            continue
        dest = lists_dir / f"{name}.json"
        if _skip_if_exists(dest, name, force, results):
            continue
        out = _try(lambda m=meta, q=query: auto_paginate(m, dict(q)), name, results)
        if out is not None:
            _write(dest, out)

    campaigns_name, _ = by_key(registry, ("GET", "/campaigns"))
    team_name, _ = by_key(registry, ("GET", "/team"))

    # Phase 2 — per-campaign drill
    if opts["with_campaigns"]:
        sys.stderr.write("\n=== Phase 2: per-campaign drill ===\n")
        campaigns = _read_collection(lists_dir / f"{campaigns_name}.json") if campaigns_name else []
        camp_endpoints = [
            (n, m) for n, m in registry.items()
            if m["method"] == "GET"
            and len(m["path_params"]) == 1
            and m["path_params"][0]["name"] == "campaignId"
            and m["key"] not in CAMPAIGN_PHASE_EXCLUDED_PATHS
        ]
        for c in campaigns:
            cid = _id_of(c)
            if not cid:
                continue
            for ep_name, meta in camp_endpoints:
                path = meta["path"].replace("{campaignId}", urllib.parse.quote(cid, safe=""))
                query, missing = _autofill_required(meta, {})
                if missing:
                    continue
                dest = out_dir / "campaigns" / cid / f"{ep_name}.json"
                label = f"campaign/{cid}/{ep_name}"
                if _skip_if_exists(dest, label, force, results):
                    continue
                out = _try(lambda m=dict(meta, path=path), q=query: auto_paginate(m, dict(q)),
                           label, results)
                if out is not None:
                    _write(dest, out)

    # Phase 3 — per-user drill
    if opts["with_users"]:
        sys.stderr.write("\n=== Phase 3: per-user drill ===\n")
        team_file = lists_dir / f"{team_name}.json" if team_name else None
        team_data = json.loads(team_file.read_text()) if team_file and team_file.exists() else {}
        user_ids = team_data.get("userIds", []) if isinstance(team_data, dict) else []
        user_n, user_m = by_key(registry, ("GET", "/users/{userId}"))
        inbox_n, inbox_m = by_key(registry, ("GET", "/inbox"))
        for uid in user_ids:
            d = out_dir / "users" / uid
            if user_m:
                path = user_m["path"].replace("{userId}", urllib.parse.quote(uid, safe=""))
                label = f"user/{uid}/profile"
                if not _skip_if_exists(d / "profile.json", label, force, results):
                    out = _try(lambda m=dict(user_m, path=path): auto_paginate(m, {}), label, results)
                    if out is not None:
                        _write(d / "profile.json", out)
            if inbox_m:
                label = f"user/{uid}/inbox"
                if not _skip_if_exists(d / "inbox.json", label, force, results):
                    out = _try(lambda m=inbox_m: auto_paginate(m, {"userId": uid}), label, results)
                    if out is not None:
                        _write(d / "inbox.json", out)

        senders_n, _ = by_key(registry, ("GET", "/team/senders"))
        lw_n, lw_m = by_key(registry, ("GET", "/lemwarm/{userMailboxId}/settings"))
        senders = _read_collection(lists_dir / f"{senders_n}.json") if senders_n else []
        if lw_m and senders:
            for s in senders:
                mid = _id_of(s)
                if not mid:
                    continue
                path = lw_m["path"].replace("{userMailboxId}", urllib.parse.quote(mid, safe=""))
                dest = out_dir / "mailboxes" / mid / "lemwarm-settings.json"
                label = f"mailbox/{mid}/lemwarm"
                if _skip_if_exists(dest, label, force, results):
                    continue
                out = _try(lambda m=dict(lw_m, path=path): auto_paginate(m, {}), label, results)
                if out is not None:
                    _write(dest, out)

    # Phase 4 — per-contact-list export
    if opts["with_lists"]:
        sys.stderr.write("\n=== Phase 4: per-contact-list export ===\n")
        cl_n, _ = by_key(registry, ("GET", "/contacts/lists"))
        ex_n, ex_m = by_key(registry, ("GET", "/contacts/lists/{listId}/entities"))
        lists_data = _read_collection(lists_dir / f"{cl_n}.json") if cl_n else []
        if ex_m:
            for li in lists_data:
                lid = _id_of(li)
                if not lid:
                    continue
                path = ex_m["path"].replace("{listId}", urllib.parse.quote(lid, safe=""))
                dest = out_dir / "contact-lists" / f"{lid}.json"
                label = f"contact-list/{lid}"
                if _skip_if_exists(dest, label, force, results):
                    continue
                out = _try(lambda m=dict(ex_m, path=path): auto_paginate(m, {}), label, results)
                if out is not None:
                    _write(dest, out)

    # Phase 5 — per-company notes
    if opts["with_companies"]:
        sys.stderr.write("\n=== Phase 5: per-company notes ===\n")
        co_n, _ = by_key(registry, ("GET", "/companies"))
        nt_n, nt_m = by_key(registry, ("GET", "/companies/{companyId}/notes"))
        companies = _read_collection(lists_dir / f"{co_n}.json") if co_n else []
        if nt_m:
            for co in companies:
                cid = _id_of(co)
                if not cid:
                    continue
                path = nt_m["path"].replace("{companyId}", urllib.parse.quote(cid, safe=""))
                dest = out_dir / "companies" / cid / "notes.json"
                label = f"company/{cid}/notes"
                if _skip_if_exists(dest, label, force, results):
                    continue
                out = _try(lambda m=dict(nt_m, path=path): auto_paginate(m, {}), label, results)
                if out is not None:
                    _write(dest, out)

    # Phase 6 — per-schedule details
    if opts["with_schedules"]:
        sys.stderr.write("\n=== Phase 6: per-schedule details ===\n")
        sl_n, _ = by_key(registry, ("GET", "/schedules"))
        sd_n, sd_m = by_key(registry, ("GET", "/schedules/{scheduleId}"))
        schedules = _read_collection(lists_dir / f"{sl_n}.json") if sl_n else []
        if sd_m:
            for sc in schedules:
                sid = _id_of(sc)
                if not sid:
                    continue
                path = sd_m["path"].replace("{scheduleId}", urllib.parse.quote(sid, safe=""))
                dest = out_dir / "schedules" / f"{sid}.json"
                label = f"schedule/{sid}"
                if _skip_if_exists(dest, label, force, results):
                    continue
                out = _try(lambda m=dict(sd_m, path=path): auto_paginate(m, {}), label, results)
                if out is not None:
                    _write(dest, out)

    # Phase 7 — the two read-only POST searches + batch campaign stats
    if opts["with_search"]:
        sys.stderr.write("\n=== Phase 7: POST search + batch stats ===\n")
        for key, fname in ((("POST", "/database/people"), "people-page1.json"),
                           (("POST", "/database/companies"), "companies-page1.json")):
            n, m = by_key(registry, key)
            if not m:
                continue
            dest = out_dir / "search" / fname
            if _skip_if_exists(dest, n, force, results):
                continue
            body = BODY_DEFAULTS.get(key, {})
            out = _try(lambda p=m["path"], b=body: rest_request("POST", p, body=b), n, results)
            if out is not None:
                _write(dest, out)

        bs_n, bs_m = by_key(registry, ("POST", "/v2/campaigns/stats/batch"))
        batch_dest = out_dir / "batch-campaign-stats.json"
        if bs_m and not _skip_if_exists(batch_dest, bs_n, force, results):
            campaigns = _read_collection(lists_dir / f"{campaigns_name}.json") if campaigns_name else []
            cids = [_id_of(c) for c in campaigns if _id_of(c)]
            if cids:
                from datetime import datetime, timedelta, timezone
                end = datetime.now(timezone.utc)
                start = end - timedelta(days=365)
                start_iso = start.strftime("%Y-%m-%dT%H:%M:%S.000Z")
                end_iso = end.strftime("%Y-%m-%dT%H:%M:%S.000Z")
                chunks = [cids[i:i + 100] for i in range(0, len(cids), 100)]
                merged: list = []
                for idx, chunk in enumerate(chunks):
                    body = {"campaignIds": chunk, "startDate": start_iso, "endDate": end_iso}
                    out = _try(lambda p=bs_m["path"], b=body: rest_request("POST", p, body=b),
                               f"{bs_n}[chunk {idx + 1}/{len(chunks)}, n={len(chunk)}]", results)
                    if out is not None:
                        merged.extend(out) if isinstance(out, list) else merged.append(out)
                if merged:
                    _write(batch_dest, {"window": {"startDate": start_iso, "endDate": end_iso},
                                        "totalCampaigns": len(cids), "chunks": len(chunks),
                                        "results": merged})

    pulled, failed, cached = results.get("pulled", []), results.get("failed", []), results.get("cached", [])
    sys.stderr.write(
        f"\nDone. pulled={len(pulled)}  cached={len(cached)}  failed={len(failed)}  "
        f"skipped(path-param)={len(skipped_path)}  skipped(required-flag)={len(skipped_required)}  "
        f"skipped(lookup)={len(skipped_lookup)}  skipped(write-method)={len(skipped_write)}  "
        f"skipped(excluded)={len(skipped_excluded)}\n"
    )
    if skipped_excluded:
        sys.stderr.write("\nExcluded by default (add with --include <name>):\n")
        for n in skipped_excluded:
            sys.stderr.write(f"  {n}\n")
    if skipped_required:
        sys.stderr.write("\nSkipped (needs a required flag — call via `lem rest`):\n")
        for n, m in skipped_required:
            sys.stderr.write(f"  {n}  (missing --{m})\n")
    if failed:
        sys.stderr.write("\nFailures:\n")
        for n, err in failed:
            sys.stderr.write(f"  {n}: {(err.splitlines() or [''])[0]}\n")
    return 1 if failed else 0


